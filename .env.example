# Public browser-safe Supabase values
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Never expose this value to client components.
SUPABASE_SERVICE_ROLE_KEY=

# Update for preview and production deployments.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Email — Resend (https://resend.com). Optional: when absent, emails are logged as dry-run.
RESEND_API_KEY=
EMAIL_FROM=Teacher OS <noreply@example.com>

# Calendar — Google / Outlook OAuth (optional, stored in Supabase Vault for production)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# OUTLOOK_CLIENT_ID=
# OUTLOOK_CLIENT_SECRET=

# Optional: Sentry / analytics
# NEXT_PUBLIC_SENTRY_DSN=

